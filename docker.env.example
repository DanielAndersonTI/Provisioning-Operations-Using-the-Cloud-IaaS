# Copie este arquivo para docker.env e preencha os valores.
#
# docker.env é ignorado pelo .gitignore e NUNCA deve ser versionado.
# O token é criado em https://hub.docker.com > Account settings >
# Personal access tokens, com permissão Read & Write.
DOCKERHUB_USER=seu-usuario
DOCKERHUB_TOKEN=
IMAGE_TAG=1.0.0
